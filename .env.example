# Copy this file to .env and fill in what you have.
# MindMesh runs fully offline with sensible defaults if you skip all of this.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# Assistant identity
ASSISTANT_NAME=MindMesh
WAKE_WORD=hey mindmesh

# Weather widget (https://openweathermap.org/api - free tier works)
# Leave blank to use simulated weather data.
OPENWEATHER_API_KEY=
DEFAULT_CITY=Pune,IN

# Optional: let the agent's free-chat fallback be answered by a real LLM
# instead of the built-in rule-based responder. Supports any OpenAI-compatible
# endpoint (OpenAI, Azure OpenAI, local servers like Ollama/LM Studio, etc).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
